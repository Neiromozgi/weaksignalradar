# СННИТ РАДАР (WSR) — example environment
#
# Copy this file to .env for local Docker/localhost startup.
#
# PostgreSQL values below are intentional LOCAL DEMO defaults.
# They are not external-service secrets and are used only by this project
# on localhost / Docker internal network.
#
# Real external API credentials MUST NOT be committed.
# Put OPENAI_API_KEY and SOURCE_API_KEY only in your local .env.
#
# .env is git-ignored and must never be committed.


# ============================================================
# PostgreSQL / Docker
# ============================================================

# Host-side connection, e.g. pytest / Alembic from Windows.
# Inside Docker Compose the backend uses hostname db.
DATABASE_URL=postgresql+psycopg://snnit:snnit_local_dev@127.0.0.1:5432/snnit_radar

POSTGRES_VERSION=16
POSTGRES_USER=snnit
POSTGRES_PASSWORD=snnit_local_dev
POSTGRES_DB=snnit_radar
POSTGRES_PORT=5432

# Local browser/backend port
BACKEND_PORT=8000


# ============================================================
# OpenAlex / source configuration
# ============================================================

# Real OpenAlex/API credential belongs only in local .env.
SOURCE_API_KEY=

# May remain empty: the application uses its configured OpenAlex default.
SOURCE_BASE_URL=

# Optional contact/mailto for OpenAlex.
OPENALEX_MAILTO=


# ============================================================
# LLM / OpenAI
# ============================================================

LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra

# Kept for compatibility if referenced by runtime configuration.
# Do not place a real secret in .env.example.
LLM_API_KEY=

# Real OpenAI key belongs only in local .env.
OPENAI_API_KEY=


# ============================================================
# Storage / runtime
# ============================================================

SNAPSHOT_DIR=
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=
MAX_RETRIES=

WEB_BASE_URL=http://127.0.0.1:8000

# Default competition/runtime embedding backend.
WSR_EMBEDDING_BACKEND=auto

# Discovery v2 (TMF + E5 clustering). Required for release/demo parity with LIVE #5 core.
DISCOVERY_V2_ENABLED=true

# Allow OpenAI provider calls (query planner / TMF / signatures). Use 1 only for LIVE.
# CACHE/SNAPSHOT ignore this flag (offline replay); leave 0 for demo without external LLM.
WSR_ALLOW_LLM_PROVIDER=0


# ============================================================
# CORDIS / EPO
# ============================================================

# Public endpoint configuration may be supplied by runtime defaults.
CORDIS_SPARQL_ENDPOINT=
EPO_SPARQL_ENDPOINT=

# Leave empty unless explicitly overriding runtime behavior.
EPO_LIVE_DISABLED=