# Names only. NO real values, NO secrets. Copy to .env locally and fill in;
# .env is git-ignored and must never be committed.
#
# For Docker Compose backend service, DATABASE_URL must use hostname `db`
# (Compose DNS), e.g. postgresql+psycopg://USER:PASSWORD@db:5432/DBNAME
# For host-side pytest/alembic against published loopback port, use 127.0.0.1.

DATABASE_URL=
POSTGRES_VERSION=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
BACKEND_PORT=
SOURCE_API_KEY=
SOURCE_BASE_URL=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
SNAPSHOT_DIR=
LOG_LEVEL=
REQUEST_TIMEOUT_SECONDS=
MAX_RETRIES=
WEB_BASE_URL=
